# --- Home Assistant Configuration ---
# The internal or external URL of your HA instance
REPORTER_HA_URL=http://192.168.1.XX:8123
# Long-lived Access Token (Created in HA Profile)
REPORTER_HA_TOKEN=your_ha_token_here

# --- Temperatur.nu Configuration ---
# Your unique reporting hash from temperatur.nu
REPORTER_TN_HASH=your_tn_hash_here
# Mapping format: HA_ENTITY_ID:TN_ID
# For aggregation use: HA_ID1|HA_ID2:TN_ID
REPORTER_SENSOR_MAPPING=sensor.outdoor_temp:my_station_1,sensor.balcony|sensor.deck:my_station_2

# --- Reporting Logic ---
# How often to report (in seconds)
REPORTER_INTERVAL=180
# Calculation mode: mean, min, or median
REPORTER_CALCULATION_MODE=mean
# Max allowed age of HA data (in seconds) before it is considered stale
REPORTER_MAX_AGE=1800

# --- MQTT Configuration ---
REPORTER_MQTT_HOST=192.168.1.XX
REPORTER_MQTT_PORT=1883
REPORTER_MQTT_USER=mqtt_user
REPORTER_MQTT_PASS=mqtt_password
REPORTER_MQTT_PREFIX=temp_reporter