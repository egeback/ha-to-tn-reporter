# --- Home Assistant Configuration ---
REPORTER_HA_URL=http://192.168.1.XX:8123
REPORTER_HA_TOKEN=your_long_lived_access_token

# --- Temperatur.nu Configuration ---
REPORTER_TN_HASH=your_tn_hash

# Format: station_id=ha_sensor_id
# - Use a pipe (|) to group multiple HA sensors for one station (min/median/mean logic).
# - Use a comma (,) to configure multiple stations.
REPORTER_SENSOR_MAPPING=sandbyang=sensor.outside_1|sensor.outside_2,garage=sensor.garage_temp

# --- Application Settings (Optional) ---
LOG_LEVEL=INFO
HEALTH_PORT=8080
REPORTER_INTERVAL=180

# --- MQTT Configuration (Optional) ---
REPORTER_MQTT_HOST=192.168.1.XX
REPORTER_MQTT_PORT=1883
REPORTER_MQTT_USER=mqtt_user
REPORTER_MQTT_PASSWORD=mqtt_password
REPORTER_MQTT_TOPIC=tn_reporter